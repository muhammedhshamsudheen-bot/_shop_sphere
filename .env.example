PORT=5050
NODE_ENV=development

# Database Configuration
# You can supply a local MongoDB or MongoDB Atlas URI:
# e.g., mongodb://localhost:27017/shopcart
# If left blank or if connection fails, it automatically starts an in-memory MongoDB instance
MONGODB_URI=

# JWT Authentication
JWT_SECRET=ecommerce_super_secure_jwt_secret_key_2026_antigravity
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Razorpay Test Mode Credentials
# Get your free test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_demoKeyId123456
RAZORPAY_KEY_SECRET=demoSecretKey987654321
# Set to 'true' to enable built-in interactive payment simulator when test keys are not active
RAZORPAY_SIMULATION_MODE=true

# Store Configuration
STORE_NAME=ShopSphere
STORE_CURRENCY=INR
STORE_CURRENCY_SYMBOL=₹
FREE_SHIPPING_THRESHOLD=999
STANDARD_SHIPPING_FEE=70
EXPRESS_SHIPPING_FEE=150
